# API-ключ для защиты эндпоинтов (придумайте сложный, например через `openssl rand -hex 32`)
API_KEY=test-key

# Настройки подключения к базе данных
DB_USER=polyflip
DB_PASSWORD=secret
DB_NAME=polyflip

# Активы для мониторинга (через запятую)
# ВАЖНО: Торговый движок использует ML-модели. Новые активы (SOL, XRP, DOGE)
# будут собираться для накопления истории. Перед запуском торговли по ним
# необходимо накопить историю (минимум 50 снепшотов) и обучить модель через дашборд.
# До этого момента торговый движок будет их игнорировать.
ASSETS=BTC,ETH,SOL,XRP,DOGE

# DSN для отправки ошибок в Sentry
SENTRY_DSN=

# Все остальные параметры (INTERVALS, MIN_EDGE и т.д.) теперь управляются
# через дашборд во вкладке "Настройки" (сохраняются в БД).


# AI Lab research remains disabled until scheduled runs are enabled. The
# independent research worker is included in the default Compose stack and
# only processes queued runs; RESEARCH is PAPER/SHADOW only and LIVE is blocked.
AI_LAB_MODE=STANDARD
AI_LAB_SCHEDULE_ENABLED=false
AI_LAB_RESEARCH_INTERVAL_SECONDS=0
AI_LAB_RESEARCH_MAX_ITERATIONS=1
AI_LAB_THREAD_PROVIDER=none
AI_LAB_LLM_PROVIDER=mock
AI_LAB_LLM_API_KEY=
# Optional standard OpenRouter name (used when AI_LAB_LLM_API_KEY is empty).
OPENROUTER_API_KEY=
AI_LAB_LLM_ENDPOINT=
AI_LAB_LLM_AVAILABLE_PROVIDERS=mock,openai,opencode,openrouter
AI_LAB_ALLOWED_MODELS=gpt-5.6-sol,gpt-5.6-terra,gpt-5.6-luna,muse-spark-1.2-contributor-free,big-pickle,nemotron-3-ultra-free
AI_LAB_MODEL_RESEARCH=gpt-5.6
AI_LAB_MODEL_SUMMARY=gpt-5.6-mini
# Must match the API_KEY fallback above unless you set a dedicated token.
AI_LAB_AGENT_TOKEN=test-key
AI_LAB_AGENT_LEASE_TTL_SECONDS=120
AI_LAB_API_BASE_URL=http://api:8001
AI_LAB_AGENT_WORKER_ID=ai-research-agent-1
AI_LAB_POLL_SECONDS=10
AI_LAB_OPENCODE_MODELS_ENDPOINT=
AI_LAB_OPENCODE_CATALOG_TTL_SECONDS=3600
AI_LAB_OPENCODE_MODELS_FALLBACK=
AI_LAB_OPENCODE_RESPONSES_ENDPOINT=https://opencode.ai/zen/v1/responses
AI_LAB_OPENCODE_CHAT_ENDPOINT=https://opencode.ai/zen/v1/chat/completions
AI_LAB_OPENCODE_CHAT_MODELS=big-pickle,nemotron-3-ultra-free
AI_LAB_OPENCODE_GO_RESPONSES_ENDPOINT=https://opencode.ai/zen/go/v1/responses
AI_LAB_OPENCODE_GO_CHAT_ENDPOINT=https://opencode.ai/zen/go/v1/chat/completions
AI_LAB_OPENCODE_GO_MESSAGES_ENDPOINT=https://opencode.ai/zen/go/v1/messages
AI_LAB_OPENCODE_PROBE_TTL_SECONDS=86400

# OpenRouter (OpenAI-compatible Chat Completions). Set provider=openrouter
# and put the OpenRouter key in AI_LAB_LLM_API_KEY to use the GO catalogue.
AI_LAB_OPENROUTER_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
AI_LAB_OPENROUTER_MODELS_ENDPOINT=https://openrouter.ai/api/v1/models
# Empty means use the built-in GO catalogue (all supported model IDs).
AI_LAB_OPENROUTER_MODELS=
AI_LAB_OPENROUTER_CATALOG_TTL_SECONDS=3600
AI_LAB_OPENROUTER_MODELS_FALLBACK=
AI_LAB_OPENROUTER_PROBE_TTL_SECONDS=86400
AI_LAB_OPENROUTER_HTTP_REFERER=
AI_LAB_OPENROUTER_X_TITLE=Flipoly AI Lab
# Weighted trading policy. LEGACY keeps the existing decision path.
TRADING_POLICY_MODE=LEGACY
WEIGHTED_POLICY_ID=UNVERSIONED
# Optional immutable artifact path inside the api container.
WEIGHTED_POLICY_ARTIFACT_PATH=
# FIXED | LOWER_BOUND_KELLY | STEPPED_EDGE ($1 -> $1.5 -> $2 -> $3)
WEIGHTED_SIZING_MODE=FIXED
WEIGHTED_STANDARD_ERROR=0
WEIGHTED_KELLY_FRACTION=0.025
WEIGHTED_SIZE_CAP_USDC=3.0

LIVE_TRADING_ENABLED=false

# PAPER uses the same public CLOB book semantics as LIVE by default.
PAPER_EXECUTION_PROFILE=LIVE_PARITY
PAPER_LIVE_DELAY_SEC=2.0
PAPER_SLIPPAGE_PCT=0.5
PAPER_FEE_RATE=0.002
PAPER_MIN_ORDER_SHARES=5
